  {
    "label": "IP flood",
    "pattern": "\\bIP flood\\b"
  },
  {
    "label": "HTTPS flood",
    "pattern": "\\bHTTPS flood\\b"
  },
  {
    "label": "DNS amplification",
    "pattern": "\\bDNS amplification\\b"
  },
  {
    "label": "Low-and-slow attack",
    "pattern": "\\b(?:low[- ]and[- ]slow|Slowloris)\\b"
  },
  {
    "label": "Vulnerability exploitation",
    "pattern": "\\b(?:vulnerability exploitation|exploiting (?:a |an |the )?(?:vulnerabilit|CVE-)|exploitation of (?:CVE-|a |an |the )|actively exploit(?:ed|ing)|active exploitation|zero[- ]day exploit(?:ation|s)?|exploit(?:ed|ing) CVE-)"
  }
]
