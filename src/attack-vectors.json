    "pattern": "\\bTCP (?:SYN )?flood\\b"
  },
  {
    "label": "UDP flood",
    "pattern": "\\bUDP flood\\b"
  },
  {
    "label": "HTTP flood",
    "pattern": "\\bHTTP(?:/2)? flood\\b"
