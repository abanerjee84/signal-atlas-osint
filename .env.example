# Copy to .env locally. Production: /etc/osint/osint.env, mode 0640.
OSINT_DATABASE=data/osint.sqlite3
OSINT_ADMIN_TOKEN=
# Private investigation APIs use the existing administrator token; public read is opt-in.
OSINT_ADVANCED_PUBLIC_READ=false
OSINT_EVIDENCE_DIRECTORY=data/evidence
OSINT_EVIDENCE_RETENTION_DAYS=180
OSINT_MEDIA_MAX_BYTES=20971520
OSINT_ADVANCED_AI_DAILY_BUDGET=20
OSINT_ADVANCED_LOOKUP_DAILY_BUDGET=100
# Public threat reference catalogs: daily refresh; no API keys.
OSINT_THREAT_CATALOGS_ENABLED=true
# Optional contact text for the SANS custom User-Agent. Never include credentials.
OSINT_SANS_CONTACT=
# Infrastructure observations, separate from named actor attribution.
OSINT_DSHIELD_ENABLED=true
OSINT_DSHIELD_LIMIT=50
# Narrow, completed-day honeypot sample. Opt in after choosing a UA filter.
OSINT_ISC_HONEYPOTS_ENABLED=false
OSINT_ISC_HONEYPOTS_USER_AGENT=jndi:ldap
OSINT_CYBER_OBSERVATION_RETENTION_DAYS=30
# Optional credentials remain backend-only. Unconfigured sources show access requirements.
OSINT_THREATFOX_AUTH_KEY=
OSINT_GREYNOISE_API_KEY=
OSINT_CLOUDFLARE_RADAR_TOKEN=
# Country-only IP estimates for the separate infrastructure map layer. No requests to observed hosts.
OSINT_INFRASTRUCTURE_GEO_ENABLED=true
OSINT_INFRASTRUCTURE_GEO_DAILY_BUDGET=250
# Administratively approved public HTTPS monitoring destinations, exact hostnames only.
OSINT_WATCH_ALLOWED_HOSTS=[]
# Optional public HTTPS SearXNG instance with JSON output enabled.
OSINT_SEARXNG_URL=
OSINT_HTTP_TIMEOUT=25
OSINT_CONNECTOR_CONCURRENCY=2
OSINT_MAX_FEED_BYTES=8388608
OSINT_MAX_RECORDS=1000
OSINT_RAW_RETENTION_DAYS=30
OSINT_EVENT_RETENTION_DAYS=180
OSINT_STATS_RETENTION_DAYS=365
OSINT_AI_CACHE_DAYS=7
OSINT_AI_DAILY_BUDGET=40
OSINT_OPENROUTER_API_KEY=
OSINT_OPENROUTER_MODEL=openrouter/free
OSINT_OPENROUTER_FALLBACK=
OSINT_AI_FREE_ONLY=true
OSINT_AI_TIMEOUT=45
OSINT_FIRMS_MAP_KEY=
OSINT_FIRMS_AREA=world
OSINT_RELIEFWEB_APPNAME=
OSINT_ACLED_EMAIL=
OSINT_ACLED_PASSWORD=
OSINT_OPENSKY_CLIENT_ID=
OSINT_OPENSKY_CLIENT_SECRET=
OSINT_OPENSKY_BBOX=world
# Current positions refresh only with a visible live Aviation layer; accepted range: 10-1800.
# Global queries cost 4 provider credits. Daily quota/backoff still applies.
OSINT_OPENSKY_POLL_SECONDS=30
# Licensed maritime feed using the schema in docs/SOURCES.md. Never configure internal hosts.
OSINT_MARITIME_URL=
OSINT_MARITIME_TOKEN=
# AIS Stream account key from https://aisstream.io/account. Server-side only:
# the service forbids direct browser connections, and this key must never reach
# a browser bundle. When empty the anonymous OpenSeaFeed/Open Waters streams
# remain the maritime source.
OSINT_AISSTREAM_API_KEY=
# BarentsWatch live AIS OAuth client credentials (free, scope=ais).
# https://id.barentswatch.no/connect/token with grant_type=client_credentials.
# The live stream (live.ais.barentswatch.no/v1/combined) carries name and ship
# type on every update for vessels in Norwegian EEZ / Svalbard zones.
OSINT_BARRENTSWATCH_CLIENT_ID=
OSINT_BARRENTSWATCH_CLIENT_SECRET=
# Global Fishing Watch v3 vessel registry token (free non-commercial):
# https://globalfishingwatch.org/our-apis/tokens. Used only for vessel identity
# enrichment (owners, flag, tonnage); never replaces AIS telemetry.
OSINT_GFW_API_TOKEN=
# NOAA Marine Cadastre bulk AIS archive (no key). Daily CSV.zst files at
# https://noaaocm.blob.core.windows.net/ais/csv2/csv2026/. Manual-only lane:
# run with OSINT worker --source noaa_marinecadastre, bounded to MAX bytes per run.
OSINT_NOAA_AIS_URL=
OSINT_NOAA_AIS_MAX_BYTES=603979776
# Multi-domain monitoring and immutable Time Machine history (docs/SHADOWBROKER_MONITORING.md).
# Maintenance enforces both age and row limits; high-volume tracking can shorten coverage.
OSINT_MONITORING_RETENTION_DAYS=7
OSINT_MONITORING_MAX_ROWS=250000
OSINT_TFL_CAMERAS_ENABLED=true
OSINT_SATNOGS_STATIONS_ENABLED=true
# Public receiver links only. No credentials, private receivers or audio recording.
OSINT_PUBLIC_RADIO_RECEIVERS=[]
# Authorized normalized ADS-B JSON endpoint with NACp. Add its exact public host below.
# OpenSky does not supply NACp; it cannot populate the GNSS accuracy layer.
OSINT_MONITORING_ADSB_URL=
# Server-side passive public-IP enrichment. No active scans or background Shodan searches.
OSINT_SHODAN_API_KEY=
OSINT_SHODAN_DAILY_BUDGET=20
# Monitoring expansion and investigation workflows: docs/SHADOWBROKER_EXPANSION.md.
# Initial defaults for NEW source rows; persisted administrator enable/disable choices win.
OSINT_EXPANSION_ENABLED=["feodo","nws_alerts","swpc","caltrans_cameras","nyc_cameras","singapore_cameras","kiwisdr","amtraker","digitraffic","volcanoes","ripe_atlas"]
OSINT_URLHAUS_AUTH_KEY=
OSINT_CALTRANS_DISTRICTS=[3,4,7,11,12]
# OpenAQ v3 latest samples are joined to sensor parameters at these location IDs.
OSINT_OPENAQ_API_KEY=
OSINT_OPENAQ_LOCATION_IDS=[]
# Callsign-scoped public PSKReporter query. No unbounded reception collection.
OSINT_PSK_CALLSIGN=
# TinyGS access is not anonymously verified. Supply authorized access or import an export.
OSINT_TINYGS_TOKEN=
OSINT_TINYGS_URL=https://api.tinygs.com/v1/satellitesWorldmap
# Uses the existing GFW token, separate from vessel registry enrichment.
OSINT_GFW_EVENT_TYPES=["fishing","encounter","loitering","port_visit","gap"]
# Versioned authorized GeoJSON feeds. Exact destination hosts belong in EXTRA_ALLOWED_HOSTS.
# Each entry: source_id, name, url, license, version, kind (power-plant/data-center/cable/supplier).
OSINT_REFERENCE_FEEDS=[]
# Authorized application-schema exports, not assumed private provider APIs. See documented fields.
OSINT_WASTEWATER_URL=
OSINT_WASTEWATER_LICENSE=
OSINT_PUBLISHED_ASSESSMENTS_URL=
OSINT_PUBLISHED_ASSESSMENTS_LICENSE=
# Shared per-UTC-day budget for operator recon, catalog searches and raster comparisons.
OSINT_EXPANSION_LOOKUP_DAILY_BUDGET=40
OSINT_IMAGERY_SEARCH_URL=https://earth-search.aws.element84.com/v1/search
OSINT_IMAGERY_ASSET_HOSTS=["earth-search.aws.element84.com","sentinel-cogs.s3.us-west-2.amazonaws.com"]
# Only sent to approved protected NASA asset hosts. Never sent to optical catalogs or the browser.
OSINT_EARTHDATA_TOKEN=
# Optional: pip install -r requirements-geo.txt. Each asset download is capped at 32 MiB.
OSINT_RASTER_MAX_PIXELS=4000000
# Explicit additional outbound hosts for configured feeds. Exact DNS names only.
OSINT_EXTRA_ALLOWED_HOSTS=[]
# Authorized RSS feed definitions; see docs/SOURCES.md.
OSINT_EXTRA_RSS=[]
# Keyless Reddit JSON archive + separately labelled Atom feeds. Archive uptime is unguaranteed.
# Reddit Atom retirement is announced for 2026-11-13.
OSINT_REDDIT_SUBREDDITS=["worldnews","geopolitics","climate"]
# YouTube public feeds provide uploads, not viewer comments.
OSINT_YOUTUBE_CHANNELS=[{"id":"UC16niRr50-MSBwiO3YDb3RA","name":"BBC News","country":"GB"},{"id":"UCknLrEdhRCp1aegoMqRaCZg","name":"DW News","country":"DE"},{"id":"UCNye-wNBqNL5ZzHSJj3l8Bg","name":"Al Jazeera English","country":"QA"}]
# Optional authorized public RSS/Atom feeds; add their exact host to EXTRA_ALLOWED_HOSTS.
OSINT_SOCIAL_FEEDS=[]
# Public Telegram channel previews, no API/login. Selected channel discourse, not verified news.
OSINT_TELEGRAM_CHANNELS=["geopoliticsandempire"]
